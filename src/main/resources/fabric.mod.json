{
  "schemaVersion": 1,
  "id": "drawlib",
  "version": "${version}",
  "name": "DrawLib",
  "description": "一个用于在世界当中渲染的简易库",
  "authors": ["sashwind"],
  "contact": {},
  "license": "AGPL-v3",
  "icon": "assets/drawlib/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "sashwind.mc.mod.drawlib.client.DrawlibClient"
    ],
    "main": [
      "sashwind.mc.mod.drawlib.Drawlib"
    ]
  },
  "mixins": [
    "drawlib.mixins.json",
    {
      "config": "drawlib.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "1.21.1"
  }
}
